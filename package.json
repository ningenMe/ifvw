{
  "name": "ifvw",
  "version": "0.0.0",
  "description": "Unified API Explorer for microservices — browse and search OpenAPI (and beyond) specs from one place.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ifvw": "./bin/ifvw.js"
  },
  "files": [
    "dist",
    "dist-browser",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:browser",
    "build:node": "tsc -p tsconfig.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "pretest": "npm run build:node",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
